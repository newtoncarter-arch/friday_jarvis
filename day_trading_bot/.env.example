# ===================== GROK (xAI) =====================
# Get a key at https://console.x.ai
XAI_API_KEY=your-xai-key-here
GROK_MODEL=grok-4
# Set to false to trade on technical signals alone (no AI filter)
USE_GROK=true
# Grok must be at least this confident (0-100) to approve a trade
GROK_MIN_CONFIDENCE=65

# ===================== BROKER (Alpaca) =====================
# Free account at https://alpaca.markets  -> use the PAPER keys first!
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret
# Data feed: "iex" is free, "sip" needs a paid plan
ALPACA_DATA_FEED=iex

# ===================== SAFETY =====================
# Paper trading (fake money) unless BOTH of these are set
LIVE_TRADING=false
I_UNDERSTAND_THE_RISK=false

# ===================== STRATEGY =====================
WATCHLIST=SPY,QQQ,AAPL,NVDA,TSLA,AMD,MSFT
TIMEFRAME=5Min
LOOP_SECONDS=60

# ===================== RISK =====================
# % of account equity risked per trade (distance to stop x shares)
RISK_PER_TRADE_PCT=0.5
# Stop trading for the day after losing this % of equity
MAX_DAILY_LOSS_PCT=2.0
MAX_OPEN_POSITIONS=3
MAX_POSITION_PCT=20
MAX_TRADES_PER_DAY=10
# Stop = entry - ATR * this ; target = entry + stop distance * REWARD_RISK
ATR_STOP_MULT=1.5
REWARD_RISK=2.0
# Minutes after the open to wait, and minutes before close to flatten everything
SKIP_FIRST_MINUTES=15
FLATTEN_MINUTES_BEFORE_CLOSE=10
ALLOW_SHORTS=false
